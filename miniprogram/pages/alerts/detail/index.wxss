page {
  min-height: 100%;
  background: #f6f7f9;
}

.page {
  padding: 36rpx 30rpx 56rpx;
}

.state_card,
.detail_card {
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(35, 46, 66, 0.06);
}

.state_card {
  padding: 48rpx 32rpx;
  color: #6b7280;
  text-align: center;
  font-size: 28rpx;
}

.error_state {
  color: #c2413c;
}

.retry_button {
  width: 230rpx;
  margin-top: 28rpx;
  border-radius: 40rpx;
  background: #1677ff;
  color: #ffffff;
  font-size: 28rpx;
}

.detail_card {
  padding: 32rpx 30rpx 38rpx;
}

.detail_header,
.meta_row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.fraud_type {
  min-width: 0;
  color: #1f2937;
  font-size: 36rpx;
  font-weight: 600;
}

.risk_tag,
.status_tag {
  flex: none;
  padding: 5rpx 14rpx;
  border-radius: 20rpx;
  font-size: 23rpx;
  line-height: 1.35;
}

.risk-low {
  background: #e9f8ef;
  color: #23824b;
}

.risk-medium {
  background: #fff4dc;
  color: #af6900;
}

.risk-high {
  background: #ffebe9;
  color: #ca3f34;
}

.risk-unknown {
  background: #eef1f5;
  color: #687385;
}

.meta_row {
  margin-top: 30rpx;
  color: #5f6877;
  font-size: 28rpx;
}

.meta_label {
  color: #7a8494;
}

.meta_value {
  color: #3f4856;
  font-size: 27rpx;
}

.status_tag {
  background: #edf4ff;
  color: #3970bd;
}

.status-closed {
  background: #eef1f5;
  color: #687385;
}

.status-following_up {
  background: #f4edff;
  color: #7956ad;
}

.divider {
  height: 1rpx;
  margin: 34rpx 0 28rpx;
  background: #edf0f4;
}

.content_label {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 600;
}

.content {
  margin-top: 20rpx;
  color: #3f4856;
  font-size: 29rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}
