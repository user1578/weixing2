.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f6f8fc;color:#344054}.state_card,.hero,.card{box-sizing:border-box;padding:28rpx;border-radius:18rpx;background:#fff;margin-bottom:20rpx}.error_state{color:#a33}.hero{border:1rpx solid #cfe0ff;background:#eaf3ff;color:#173f78}.title{font-size:38rpx;font-weight:700}.status{display:inline-block;margin-top:15rpx;padding:5rpx 14rpx;border-radius:999rpx;background:#d7e8ff;color:#1d4ed8;font-size:25rpx}.hint{margin-top:15rpx;color:#5f789d;font-size:24rpx;line-height:1.6}.card{border:1rpx solid #e1e9f4;line-height:1.65;font-size:27rpx}.card_title{margin-bottom:18rpx;color:#172f59;font-size:31rpx;font-weight:700}.info_row{display:flex;align-items:flex-start;padding:12rpx 0;border-top:1rpx solid #edf2f7}.info_row:first-of-type{border-top:0}.info_label{flex:none;width:150rpx;color:#7a879a;font-size:24rpx}.info_value{min-width:0;flex:1;color:#344054;overflow-wrap:anywhere;word-break:break-all}.stacked{display:block}.stacked .info_label{width:auto;margin-bottom:6rpx}.close_card{border-color:#d7e6ff;background:#f8fbff}
