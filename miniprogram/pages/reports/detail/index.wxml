<view class="page">
  <view class="state_card" wx:if="{{loading}}">正在加载工单详情…</view>
  <view class="state_card error_state" wx:elif="{{errorMessage}}"><view>{{errorMessage}}</view><button bindtap="loadDetail">重新加载</button></view>
  <block wx:elif="{{report}}">
    <view class="hero"><view class="title">{{report.fraudTypeText}}</view><view class="status">{{report.statusText}}</view><view class="hint">当前公开进度以保卫处和辅导员的实际处理结果为准</view></view>
    <view class="card"><view class="card_title">事件基本信息</view><view>事件时间：{{report.incidentAtText}}</view><view>涉及金额：{{report.involvedAmount}}</view><view>是否损失：{{report.hasLoss ? '是' : '否'}}</view><view>事件经过：{{report.incidentNarrative}}</view><view wx:if="{{report.suspiciousPlatform}}">可疑平台：{{report.suspiciousPlatform}}</view><view wx:if="{{report.suspiciousAccount}}">可疑账号：{{report.suspiciousAccount}}</view><view wx:if="{{report.contactPhone}}">联系电话：{{report.contactPhone}}</view></view>
    <view class="card"><view class="card_title">工单进度</view><view>风险等级：{{report.riskText}}</view><view>当前状态：{{report.statusText}}</view><view>提交时间：{{report.submittedAtText}}</view></view>
    <view class="card" wx:if="{{report.isClosed}}"><view class="card_title">结案信息</view><view>结案结果：{{report.outcomeText}}</view><view wx:if="{{report.hasConfirmedLoss}}">确认损失金额：{{report.confirmedLossAmount}}</view><view>结案时间：{{report.closedAtText}}</view></view>
  </block>
</view>
