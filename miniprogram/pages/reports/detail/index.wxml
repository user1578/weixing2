<view class="page">
  <view class="state_card" wx:if="{{loading}}">正在加载工单详情…</view>
  <view class="state_card error_state" wx:elif="{{errorMessage}}"><view>{{errorMessage}}</view><button bindtap="loadDetail">重新加载</button></view>
  <block wx:elif="{{report}}">
    <view class="hero"><view class="title">{{report.fraudTypeText}}</view><view class="status">{{report.statusText}}</view><view class="hint">当前公开进度以保卫处和辅导员的实际处理结果为准</view></view>
    <view class="card"><view class="card_title">事件基本信息</view><view class="info_row"><view class="info_label">事件时间</view><view class="info_value">{{report.incidentAtText}}</view></view><view class="info_row"><view class="info_label">涉及金额</view><view class="info_value">{{report.involvedAmount}}</view></view><view class="info_row"><view class="info_label">是否损失</view><view class="info_value">{{report.hasLoss ? '是' : '否'}}</view></view><view class="info_row stacked"><view class="info_label">事件经过</view><view class="info_value">{{report.incidentNarrative}}</view></view><view class="info_row stacked" wx:if="{{report.suspiciousPlatform}}"><view class="info_label">可疑平台</view><view class="info_value">{{report.suspiciousPlatform}}</view></view><view class="info_row stacked" wx:if="{{report.suspiciousAccount}}"><view class="info_label">可疑账号</view><view class="info_value">{{report.suspiciousAccount}}</view></view><view class="info_row stacked" wx:if="{{report.contactPhone}}"><view class="info_label">联系电话</view><view class="info_value">{{report.contactPhone}}</view></view></view>
    <view class="card"><view class="card_title">工单进度</view><view class="info_row"><view class="info_label">风险等级</view><view class="info_value">{{report.riskText}}</view></view><view class="info_row"><view class="info_label">当前状态</view><view class="info_value">{{report.statusText}}</view></view><view class="info_row"><view class="info_label">提交时间</view><view class="info_value">{{report.submittedAtText}}</view></view></view>
    <view class="card close_card" wx:if="{{report.isClosed}}"><view class="card_title">结案结果</view><view class="info_row"><view class="info_label">结案结果</view><view class="info_value">{{report.outcomeText}}</view></view><view class="info_row" wx:if="{{report.hasConfirmedLoss}}"><view class="info_label">确认损失金额</view><view class="info_value">{{report.confirmedLossAmount}}</view></view><view class="info_row"><view class="info_label">结案时间</view><view class="info_value">{{report.closedAtText}}</view></view></view>
  </block>
</view>
