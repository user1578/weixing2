.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; background: #f6f8fc; }
.page_header { margin: 8rpx 0 24rpx; }.page_title { font-size: 40rpx; font-weight: 700; color: #172033; }.page_subtitle { margin-top: 10rpx; font-size: 25rpx; color: #68758a; }
.state_card,.report_card { display:block; width:100%; box-sizing:border-box; padding:28rpx; border-radius:18rpx; background:#fff; color:#43536b; text-align:left; }.error_state { color:#a33; }.retry_button { margin-top:20rpx; }.report_list { display:flex; flex-direction:column; gap:18rpx; }.report_card { border:0; }.report_top,.report_meta { display:flex; justify-content:space-between; gap:20rpx; }.fraud_type { font-size:31rpx; font-weight:700; color:#172033; }.risk_tag { color:#b85e00; font-size:25rpx; }.report_meta { margin-top:20rpx; color:#3562b3; font-size:25rpx; }.report_time { margin-top:14rpx; color:#7a879a; font-size:24rpx; }
