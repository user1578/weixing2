<view class="page">
  <view class="brand">校园反诈</view>
  <view class="card">
    <view class="title">验证预分配身份</view>
    <view class="hint">请输入管理员预先分配的身份编号和姓名。系统将自动确认可用身份。</view>

    <view class="field">
      <view class="label">身份编号</view>
      <input class="input" value="{{identityNo}}" data-field="identityNo" bindinput="onFieldInput" placeholder="请输入学号或工号" maxlength="64" />
    </view>
    <view class="field">
      <view class="label">姓名</view>
      <input class="input" value="{{name}}" data-field="name" bindinput="onFieldInput" placeholder="请输入姓名" maxlength="64" />
    </view>

    <view class="error" wx:if="{{errorMessage}}">{{errorMessage}}</view>
    <button class="submit" bindtap="submitBinding" loading="{{submitting}}" disabled="{{submitting}}">确认验证</button>
  </view>
</view>
