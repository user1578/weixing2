.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 56rpx 24rpx calc(64rpx + env(safe-area-inset-bottom));
  background: #f5f8fc;
  color: #17233d;
}

.brand {
  margin: 0 8rpx 28rpx;
  color: #1e3a8a;
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.card {
  box-sizing: border-box;
  width: 100%;
  padding: 36rpx 30rpx;
  border: 1rpx solid #dbeafe;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(37, 99, 235, 0.08);
}

.title {
  color: #17233d;
  font-size: 40rpx;
  font-weight: 700;
  overflow-wrap: anywhere;
}

.hint {
  margin-top: 14rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.field {
  margin-top: 34rpx;
}

.label {
  color: #334155;
  font-size: 26rpx;
  font-weight: 600;
}

.input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin-top: 14rpx;
  padding: 0 22rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 14rpx;
  color: #17233d;
  font-size: 27rpx;
}

.error {
  margin-top: 24rpx;
  color: #b91c1c;
  font-size: 24rpx;
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.submit {
  margin-top: 36rpx;
  border-radius: 999rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 28rpx;
}
