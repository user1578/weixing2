.page { box-sizing: border-box; min-height: 100vh; padding: 28rpx 24rpx calc(64rpx + env(safe-area-inset-bottom)); background: #f5f8fc; color: #17233d; }.page_header { margin: 8rpx 6rpx 26rpx; }.page_title { font-size: 40rpx; font-weight: 700; }.page_subtitle { margin-top: 10rpx; color: #718197; font-size: 24rpx; line-height: 1.55; }.search_card,.student_card,.focus_form,.state_card { box-sizing: border-box; border-radius: 20rpx; background: #fff; }.search_card { display: flex; gap: 16rpx; padding: 18rpx; border: 1rpx solid #dbeafe; }.search_input { flex: 1; min-width: 0; height: 72rpx; padding: 0 16rpx; border-radius: 12rpx; background: #f8fafc; font-size: 27rpx; }.search_button,.save_button,.cancel_button,.small_button { margin: 0; border-radius: 999rpx; font-size: 24rpx; }.search_button,.save_button { background: #2563eb; color: #fff; }.search_button { flex: none; padding: 0 26rpx; }.section_title { margin: 34rpx 6rpx 18rpx; font-size: 31rpx; font-weight: 700; }.student_card { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 16rpx; padding: 24rpx; border: 1rpx solid #e1e9f4; }.student_copy { min-width: 0; }.student_name { overflow-wrap: anywhere; font-size: 29rpx; font-weight: 600; word-break: break-all; }.student_no,.reason_preview { margin-top: 8rpx; color: #718197; font-size: 23rpx; overflow-wrap: anywhere; word-break: break-all; }.reason_preview { color: #9f4b5e; }.small_button { flex: none; padding: 0 20rpx; background: #eaf2ff; color: #2563eb; }.focus_form { margin-top: 24rpx; padding: 28rpx; border: 1rpx solid #bfdbfe; }.form_title { font-size: 31rpx; font-weight: 700; }.form_student { margin-top: 10rpx; color: #718197; font-size: 24rpx; }.reason_input { box-sizing: border-box; width: 100%; min-height: 160rpx; margin-top: 22rpx; padding: 18rpx; border-radius: 14rpx; background: #f8fafc; font-size: 26rpx; line-height: 1.55; }.save_button,.cancel_button { margin-top: 20rpx; }.cancel_button { background: #fff1f2; color: #be123c; }.state_card { padding: 32rpx 24rpx; color: #64748b; text-align: center; }.error_state { color: #b91c1c; }
