<view class="page">
  <view class="page_header"><view class="page_title">重点关注</view><view class="page_subtitle">仅可管理当前学院学生，关注原因仅在辅导员工作台内使用。</view></view>
  <view class="search_card"><input class="search_input" placeholder="输入学生姓名或学号" value="{{keyword}}" bindinput="inputKeyword" maxlength="64" /><button class="search_button" bindtap="searchStudents" loading="{{searching}}" disabled="{{searching}}">搜索</button></view>
  <view class="section_title" wx:if="{{searchResults.length}}">搜索结果</view>
  <view class="student_card" wx:for="{{searchResults}}" wx:key="studentId"><view class="student_copy"><view class="student_name">{{item.name}}</view><view class="student_no">{{item.studentNo}}</view><view class="reason_preview" wx:if="{{item.focusFlag}}">当前原因：{{item.focusReason}}</view></view><button class="small_button" data-student-id="{{item.studentId}}" bindtap="selectStudent">{{item.focusFlag ? '修改原因' : '添加关注'}}</button></view>
  <view class="focus_form" wx:if="{{selectedStudent}}"><view class="form_title">{{selectedStudent.focusFlag ? '修改关注原因' : '添加重点关注'}}</view><view class="form_student">{{selectedStudent.name}} · {{selectedStudent.studentNo}}</view><textarea class="reason_input" placeholder="请输入关注原因（最多 500 字）" value="{{focusReason}}" maxlength="500" bindinput="inputReason" /><button class="save_button" bindtap="saveFocus" loading="{{saving}}" disabled="{{saving}}">保存</button><button class="cancel_button" wx:if="{{selectedStudent.focusFlag}}" bindtap="cancelFocus" disabled="{{saving}}">取消重点关注</button></view>
  <view class="section_title">已重点关注</view>
  <view class="state_card error_state" wx:if="{{errorMessage}}">{{errorMessage}}</view>
  <view class="state_card" wx:elif="{{loading}}">正在加载…</view>
  <view class="state_card" wx:elif="{{!focusedStudents.length}}">当前没有重点关注学生。</view>
  <block wx:else>
    <view class="student_card" wx:for="{{focusedStudents}}" wx:key="studentId"><view class="student_copy"><view class="student_name">{{item.name}}</view><view class="student_no">{{item.studentNo}}</view><view class="reason_preview">关注原因：{{item.focusReason}}</view></view><button class="small_button" data-student-id="{{item.studentId}}" bindtap="selectStudent">管理</button></view>
  </block>
</view>
