<view class="page">
  <view class="state_card" wx:if="{{loading}}">正在加载工单详情…</view>
  <view class="state_card error_state" wx:elif="{{errorMessage}}">{{errorMessage}}</view>
  <block wx:if="{{report && !loading}}">
    <view class="card summary_card"><view class="title">{{report.fraudTypeText}}</view><view class="summary_tags"><view class="status_tag">{{report.statusText}}</view><view class="risk_tag">{{report.riskText}}</view></view><view class="submitted_text">提交时间：{{report.submittedAtText}}</view></view>
    <view class="card"><view class="subtitle">学生与事件信息</view><view class="info_row"><view class="info_label">姓名</view><view class="info_value">{{report.student.name}}</view></view><view class="info_row"><view class="info_label">学号</view><view class="info_value">{{report.student.studentNo}}</view></view><view class="info_row"><view class="info_label">事件时间</view><view class="info_value">{{report.incidentAtText}}</view></view><view class="info_row"><view class="info_label">涉及金额</view><view class="info_value">{{report.involvedAmount}}</view></view><view class="info_row"><view class="info_label">是否损失</view><view class="info_value">{{report.hasLossText}}</view></view><view class="info_row stacked"><view class="info_label">事件经过</view><view class="info_value">{{report.incidentNarrative}}</view></view><view class="info_row stacked"><view class="info_label">可疑平台</view><view class="info_value">{{report.suspiciousPlatform}}</view></view><view class="info_row stacked"><view class="info_label">可疑账号</view><view class="info_value">{{report.suspiciousAccount}}</view></view><view class="info_row"><view class="info_label">是否仍联系</view><view class="info_value">{{report.stillContacting ? '是' : '否'}}</view></view><view class="info_row stacked"><view class="info_label">联系电话</view><view class="info_value">{{report.contactPhone}}</view></view><view class="info_row stacked"><view class="info_label">学生补充</view><view class="info_value">{{report.studentRemark}}</view></view><view class="info_row stacked"><view class="info_label">风险原因</view><view class="info_value">{{report.riskReasons}}</view></view></view>
    <view class="card action_card" wx:if="{{workflow}}"><view class="subtitle">处理操作</view><view class="action_buttons"><button class="primary_action" wx:if="{{workflow.canStartFollowup}}" data-mode="start" bindtap="chooseAction">开始跟进</button><button class="primary_action" wx:if="{{workflow.followupStatus === 'pending'}}" data-mode="contact" bindtap="chooseAction">记录联系</button><button class="primary_action" wx:if="{{workflow.followupStatus === 'in_progress'}}" data-mode="transfer" bindtap="chooseAction">转保卫处</button><button class="secondary_action" wx:if="{{workflow.followupStatus === 'in_progress' && report.riskLevel === 'low' && !report.hasLoss}}" data-mode="close" bindtap="chooseAction">直接结案</button></view><view class="workflow_hint" wx:if="{{workflow.followupStatus}}">当前跟进状态：{{workflow.followupStatus}}</view></view>
    <view class="card form" wx:if="{{actionMode === 'start'}}"><view class="subtitle">开始跟进</view><textarea placeholder="填写初步意见" maxlength="1000" data-key="opinion" bindinput="updateField"/><button class="primary_action" loading="{{saving}}" bindtap="startFollowup">确认开始</button><button class="secondary_action" bindtap="cancelAction">取消</button></view>
    <view class="card form" wx:if="{{actionMode === 'contact'}}"><view class="subtitle">记录联系</view><input value="{{form.contactedAt}}" placeholder="ISO8601 时间（含时区）" data-key="contactedAt" bindinput="updateField"/><picker class="form_picker" range="{{['phone','wechat','in_person','other']}}" bindchange="selectContactMethod"><view>联系方法：{{form.contactMethod}}</view></picker><button class="primary_action" loading="{{saving}}" bindtap="recordContact">确认记录</button><button class="secondary_action" bindtap="cancelAction">取消</button></view>
    <view class="card form" wx:if="{{actionMode === 'transfer'}}"><view class="subtitle">转保卫处</view><picker class="form_picker" range="{{transferResults}}" bindchange="selectTransferResult"><view>核验结果：{{form.verificationResult}}</view></picker><textarea placeholder="填写转交原因" maxlength="1000" data-key="transferReason" bindinput="updateField"/><button class="primary_action" loading="{{saving}}" bindtap="transferToSecurity">确认提交</button><button class="secondary_action" bindtap="cancelAction">取消</button></view>
    <view class="card form" wx:if="{{actionMode === 'close'}}"><view class="subtitle">辅导员直接结案</view><picker class="form_picker" range="{{closeResults}}" bindchange="selectCloseResult"><view>核验结果：{{form.verificationResult}}</view></picker><textarea placeholder="填写结案原因" maxlength="1000" data-key="closeReason" bindinput="updateField"/><button class="primary_action" loading="{{saving}}" bindtap="closeReport">确认提交</button><button class="secondary_action" bindtap="cancelAction">取消</button></view>
  </block>
</view>
