<view class="page">
  <view class="state_card" wx:if="{{loading}}">正在加载工单详情…</view>
  <view class="state_card error_state" wx:elif="{{errorMessage}}">{{errorMessage}}</view>
  <block wx:if="{{report && !loading}}">
    <view class="card"><view class="title">{{report.fraudTypeText}}</view><view>状态：{{report.statusText}}</view><view>风险等级：{{report.riskText}}</view><view>提交时间：{{report.submittedAtText}}</view></view>
    <view class="card"><view class="subtitle">学生与事件信息</view><view>姓名：{{report.student.name}}</view><view>学号：{{report.student.studentNo}}</view><view>事件时间：{{report.incidentAtText}}</view><view>涉及金额：{{report.involvedAmount}}</view><view>是否损失：{{report.hasLossText}}</view><view>事件经过：{{report.incidentNarrative}}</view><view>可疑平台：{{report.suspiciousPlatform}}</view><view>可疑账号：{{report.suspiciousAccount}}</view><view>是否仍联系：{{report.stillContacting ? '是' : '否'}}</view><view>联系电话：{{report.contactPhone}}</view><view>学生补充：{{report.studentRemark}}</view><view>风险原因：{{report.riskReasons}}</view></view>
    <view class="card" wx:if="{{workflow}}"><view class="subtitle">处理操作</view><button wx:if="{{workflow.canStartFollowup}}" data-mode="start" bindtap="chooseAction">开始跟进</button><button wx:if="{{workflow.followupStatus === 'pending'}}" data-mode="contact" bindtap="chooseAction">记录联系</button><button wx:if="{{workflow.followupStatus === 'in_progress'}}" data-mode="transfer" bindtap="chooseAction">转保卫处</button><button wx:if="{{workflow.followupStatus === 'in_progress' && report.riskLevel === 'low' && !report.hasLoss}}" data-mode="close" bindtap="chooseAction">直接结案</button><view wx:if="{{workflow.followupStatus}}">当前跟进状态：{{workflow.followupStatus}}</view></view>
    <view class="card form" wx:if="{{actionMode === 'start'}}"><view class="subtitle">开始跟进</view><textarea placeholder="填写初步意见" maxlength="1000" data-key="opinion" bindinput="updateField"/><button loading="{{saving}}" bindtap="startFollowup">确认开始</button><button class="secondary" bindtap="cancelAction">取消</button></view>
    <view class="card form" wx:if="{{actionMode === 'contact'}}"><view class="subtitle">记录联系</view><input value="{{form.contactedAt}}" placeholder="ISO8601 时间（含时区）" data-key="contactedAt" bindinput="updateField"/><picker range="{{['phone','wechat','in_person','other']}}" bindchange="selectContactMethod"><view>联系方法：{{form.contactMethod}}</view></picker><button loading="{{saving}}" bindtap="recordContact">确认记录</button><button class="secondary" bindtap="cancelAction">取消</button></view>
    <view class="card form" wx:if="{{actionMode === 'transfer'}}"><view class="subtitle">转保卫处</view><picker range="{{transferResults}}" bindchange="selectTransferResult"><view>核验结果：{{form.verificationResult}}</view></picker><textarea placeholder="填写转交原因" maxlength="1000" data-key="transferReason" bindinput="updateField"/><button loading="{{saving}}" bindtap="transferToSecurity">确认提交</button><button class="secondary" bindtap="cancelAction">取消</button></view>
    <view class="card form" wx:if="{{actionMode === 'close'}}"><view class="subtitle">辅导员直接结案</view><picker range="{{closeResults}}" bindchange="selectCloseResult"><view>核验结果：{{form.verificationResult}}</view></picker><textarea placeholder="填写结案原因" maxlength="1000" data-key="closeReason" bindinput="updateField"/><button loading="{{saving}}" bindtap="closeReport">确认提交</button><button class="secondary" bindtap="cancelAction">取消</button></view>
  </block>
</view>
