.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f6f8fc;color:#344054}.state_card,.card{margin-bottom:20rpx;padding:28rpx;border-radius:18rpx;background:#fff;line-height:1.8}.error_state{color:#a33}.title{font-size:36rpx;font-weight:700;color:#172033}.subtitle{font-size:30rpx;font-weight:700;color:#172033;margin-bottom:10rpx}.card button{margin-top:18rpx;margin-right:12rpx}.form input,.form textarea{display:block;width:100%;box-sizing:border-box;padding:16rpx;margin:14rpx 0;background:#f6f8fc;border-radius:10rpx}.secondary{background:#edf1f8;color:#43536b}
