.page{min-height:100vh;padding:28rpx;box-sizing:border-box;background:#f6f8fc;color:#344054}.state_card,.card{box-sizing:border-box;margin-bottom:20rpx;padding:28rpx;border:1rpx solid #e1e9f4;border-radius:18rpx;background:#fff;line-height:1.65}.error_state{color:#a33}.summary_card{border-color:#cfe0ff;background:#f5f9ff}.title{font-size:36rpx;font-weight:700;color:#172f59}.summary_tags{display:flex;gap:12rpx;margin-top:16rpx}.status_tag,.risk_tag{padding:5rpx 14rpx;border-radius:999rpx;font-size:23rpx}.status_tag{background:#dceaff;color:#1d4ed8}.risk_tag{background:#fff4dc;color:#b45309}.submitted_text,.workflow_hint{margin-top:16rpx;color:#718197;font-size:24rpx}.subtitle{margin-bottom:18rpx;font-size:30rpx;font-weight:700;color:#172033}.info_row{display:flex;align-items:flex-start;padding:12rpx 0;border-top:1rpx solid #edf2f7}.info_row:first-of-type{border-top:0}.info_label{flex:none;width:150rpx;color:#7a879a;font-size:24rpx}.info_value{min-width:0;flex:1;color:#344054;overflow-wrap:anywhere;word-break:break-all}.stacked{display:block}.stacked .info_label{width:auto;margin-bottom:6rpx}.action_buttons{display:flex;flex-wrap:wrap;margin:0 -6rpx}.card button{box-sizing:border-box;margin:12rpx 6rpx 0;padding:18rpx 22rpx;font-size:27rpx}.primary_action{background:#2563eb;color:#fff}.secondary_action{background:#edf3fb;color:#46627f}.form input,.form textarea,.form_picker{display:block;width:100%;box-sizing:border-box;padding:18rpx;margin:14rpx 0;border:1rpx solid #dce6f2;border-radius:12rpx;background:#f8fbff;color:#344054;font-size:26rpx}.form textarea{min-height:160rpx}
