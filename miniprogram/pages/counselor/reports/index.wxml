<view class="page">
  <view class="page_header">
    <view class="page_title">{{scopeTitle}}</view>
    <view class="page_subtitle">仅展示当前学院、当前权限范围内的待办</view>
  </view>
  <view class="scope_tabs"><button data-scope="pending" class="scope_tab {{scope === 'pending' ? 'active' : ''}}" bindtap="selectScope">待核验</button><button data-scope="following" class="scope_tab {{scope === 'following' ? 'active' : ''}}" bindtap="selectScope">跟进中</button><button data-scope="history" class="scope_tab {{scope === 'history' ? 'active' : ''}}" bindtap="selectScope">工单记录</button></view>

  <view class="state_card" wx:if="{{loading}}">正在加载工单…</view>

  <view class="state_card error_state" wx:elif="{{errorMessage}}">
    <view>{{errorMessage}}</view>
    <button class="retry_button" bindtap="loadReports">重新加载</button>
  </view>

  <view class="state_card" wx:elif="{{loaded && reports.length === 0}}">当前没有待核验工单</view>

  <view class="report_list" wx:elif="{{reports.length}}">
    <view class="report_item" wx:for="{{reports}}" wx:key="reportId">
      <button class="report_card" data-report-id="{{item.reportId}}" bindtap="openDetail">
        <view class="report_top">
          <view class="fraud_type">{{item.fraudTypeText}}</view>
          <view class="risk_tag {{item.riskClass}}">{{item.riskText}}</view>
        </view>
        <view class="report_bottom">
          <view class="status_tag">{{item.statusText}}</view>
          <view class="report_hint">提交时间：{{item.submittedAtText}}</view>
        </view>
      </button>
    </view>
  </view>
</view>
