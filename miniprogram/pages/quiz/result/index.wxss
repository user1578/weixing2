.page { box-sizing: border-box; min-height: 100vh; padding: 28rpx 24rpx calc(64rpx + env(safe-area-inset-bottom)); background: #f5f8fc; color: #17233d; }.state_card,.score_card,.result_card { box-sizing: border-box; border-radius: 20rpx; background: #fff; }.state_card { padding: 34rpx 28rpx; color: #64748b; text-align: center; }.error_state { color: #b91c1c; }.score_card { padding: 40rpx 30rpx; border: 1rpx solid #bfdbfe; background: #eff6ff; text-align: center; }.score_kicker { color: #2563eb; font-size: 25rpx; font-weight: 600; }.score_value { margin-top: 16rpx; color: #1d4ed8; font-size: 78rpx; font-weight: 700; line-height: 1; }.score_value text { margin-left: 6rpx; font-size: 33rpx; }.score_detail { margin-top: 18rpx; color: #587196; font-size: 27rpx; }.section_title { margin: 38rpx 6rpx 20rpx; font-size: 32rpx; font-weight: 700; }.result_card { margin-bottom: 18rpx; padding: 26rpx; border: 1rpx solid #e1e9f4; }.result_top { display: flex; justify-content: space-between; gap: 18rpx; color: #17233d; font-size: 28rpx; font-weight: 600; }.result_status { padding: 4rpx 12rpx; border-radius: 999rpx; font-size: 21rpx; }.right { background: #ecfdf5; color: #047857; }.wrong { background: #fff1f2; color: #be123c; }.answer_line { margin-top: 18rpx; color: #2563eb; font-size: 26rpx; }.explanation { margin-top: 14rpx; overflow-wrap: anywhere; color: #64748b; font-size: 25rpx; line-height: 1.65; word-break: break-all; }.retry_button { margin-top: 28rpx; border-radius: 999rpx; background: #2563eb; color: #fff; font-size: 29rpx; }
