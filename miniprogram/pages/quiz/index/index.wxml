<view class="page">
  <view class="page_header"><view class="page_title">安全自测</view><view class="page_subtitle">请完成全部单选题后提交，结果会展示正确答案和解析。</view></view>
  <view class="state_card" wx:if="{{loading}}">正在加载题目…</view>
  <view class="state_card error_state" wx:elif="{{errorMessage}}">{{errorMessage}}</view>
  <view wx:elif="{{questions.length}}">
    <view class="question_card" wx:for="{{questions}}" wx:key="questionId">
      <view class="question_number">第 {{item.number}} 题 · 单选题</view>
      <view class="question_stem">{{item.question}}</view>
      <radio-group class="option_group" data-question-id="{{item.questionId}}" bindchange="selectAnswer">
        <label class="option_row" wx:for="{{item.options}}" wx:key="id">
          <radio color="#2563eb" value="{{item.id}}" checked="{{answers[item.questionId] === item.id}}" />
          <text class="option_text">{{item.id}}. {{item.text}}</text>
        </label>
      </radio-group>
    </view>
    <button class="submit_button" bindtap="submitQuiz" loading="{{submitting}}" disabled="{{submitting}}">提交答案</button>
  </view>
</view>
