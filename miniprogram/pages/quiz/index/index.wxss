.page { box-sizing: border-box; min-height: 100vh; padding: 28rpx 24rpx calc(64rpx + env(safe-area-inset-bottom)); background: #f5f8fc; color: #17233d; }.page_header { margin: 8rpx 6rpx 28rpx; }.page_title { font-size: 40rpx; font-weight: 700; }.page_subtitle { margin-top: 10rpx; color: #718197; font-size: 25rpx; line-height: 1.55; }.state_card,.question_card { box-sizing: border-box; border-radius: 20rpx; background: #fff; }.state_card { padding: 34rpx 28rpx; color: #64748b; text-align: center; }.error_state { color: #b91c1c; }.question_card { margin-bottom: 18rpx; padding: 28rpx; border: 1rpx solid #dbeafe; box-shadow: 0 8rpx 22rpx rgba(30, 41, 59, 0.05); }.question_number { color: #2563eb; font-size: 23rpx; font-weight: 600; }.question_stem { margin-top: 18rpx; overflow-wrap: anywhere; font-size: 30rpx; font-weight: 600; line-height: 1.55; word-break: break-all; }.option_group { margin-top: 22rpx; }.option_row { display: flex; align-items: flex-start; box-sizing: border-box; width: 100%; margin-top: 12rpx; padding: 19rpx 16rpx; border-radius: 14rpx; background: #f8fafc; color: #334155; font-size: 27rpx; line-height: 1.5; }.option_text { flex: 1; margin-left: 12rpx; overflow-wrap: anywhere; word-break: break-all; }.submit_button { margin: 32rpx 0 0; border-radius: 999rpx; background: #2563eb; color: #fff; font-size: 29rpx; }
