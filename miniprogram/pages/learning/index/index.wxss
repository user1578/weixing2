.page { box-sizing: border-box; min-height: 100vh; padding: 28rpx 24rpx calc(64rpx + env(safe-area-inset-bottom)); background: #f5f8fc; color: #17233d; }
.page_header { margin: 8rpx 6rpx 28rpx; }.page_title { color: #17233d; font-size: 40rpx; font-weight: 700; }.page_subtitle { margin-top: 10rpx; color: #718197; font-size: 25rpx; line-height: 1.55; }
.state_card { box-sizing: border-box; padding: 34rpx 28rpx; border: 1rpx solid #e1e9f4; border-radius: 20rpx; background: #fff; color: #64748b; font-size: 27rpx; text-align: center; }.error_state { color: #b91c1c; }
.article_list { display: flex; flex-direction: column; width: 100%; }.article_item { box-sizing: border-box; width: 100%; margin-bottom: 18rpx; }.article_card { display: block; box-sizing: border-box; width: 100%; margin: 0; padding: 28rpx; border: 1rpx solid #dbeafe; border-radius: 20rpx; background: #fff; color: #17233d; text-align: left; box-shadow: 0 8rpx 22rpx rgba(30, 41, 59, 0.05); }.article_card::after { border: 0; }
.article_top { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; }.category,.completed_tag { padding: 5rpx 12rpx; border-radius: 999rpx; font-size: 21rpx; }.category { background: #eaf2ff; color: #2563eb; }.completed_tag { background: #ecfdf5; color: #047857; }.article_title { margin-top: 20rpx; overflow-wrap: anywhere; color: #17233d; font-size: 31rpx; font-weight: 700; }.article_summary { display: -webkit-box; margin-top: 12rpx; overflow: hidden; color: #64748b; font-size: 25rpx; line-height: 1.6; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.article_time { margin-top: 18rpx; color: #8b9ab0; font-size: 22rpx; }
