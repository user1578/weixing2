.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 24rpx calc(64rpx + env(safe-area-inset-bottom));
  background: #f5f8fc;
  color: #17233d;
}

.brand_bar,
.identity_main,
.identity_bottom,
.overview_head,
.section_head,
.feature_top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
}

.brand_bar {
  margin: 6rpx 4rpx 24rpx;
}

.brand_mark {
  color: #1e3a8a;
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.brand_hint,
.section_note,
.overview_loading {
  color: #7890af;
  font-size: 23rpx;
}

.identity_card {
  box-sizing: border-box;
  overflow: hidden;
  padding: 30rpx;
  border: 1rpx solid #dbeafe;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(37, 99, 235, 0.08);
}

.identity_copy {
  min-width: 0;
}

.identity_name {
  overflow: hidden;
  color: #17233d;
  font-size: 40rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity_meta {
  margin-top: 10rpx;
  overflow-wrap: anywhere;
  color: #64748b;
  font-size: 25rpx;
}

.identity_tag {
  flex: none;
  margin-left: 20rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #eaf2ff;
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 600;
}

.identity_bottom {
  min-height: 62rpx;
  margin-top: 26rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid #e8effa;
  color: #7a8ca5;
  font-size: 23rpx;
}

.hello_block {
  margin: 42rpx 6rpx 24rpx;
}

.hello_title {
  color: #17233d;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.hello_subtitle {
  margin-top: 10rpx;
  color: #70819a;
  font-size: 26rpx;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.risk_overview,
.counselor_overview {
  box-sizing: border-box;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(30, 41, 59, 0.06);
}

.risk_overview {
  border: 1rpx solid #dbeafe;
}

.counselor_overview {
  border: 1rpx solid #e2eaf5;
}

.section_kicker {
  color: #2563eb;
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.overview_head {
  margin-top: 8rpx;
}

.overview_title {
  color: #1e293b;
  font-size: 33rpx;
  font-weight: 700;
}

.metric_grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 26rpx;
}

.metric {
  box-sizing: border-box;
  width: 48.5%;
  min-height: 142rpx;
  margin-bottom: 16rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f7faff;
}

.wide_metric {
  width: 100%;
  min-height: 120rpx;
  margin-bottom: 0;
  background: #f8fafc;
}

.urgent_metric {
  border: 1rpx solid #fecaca;
  background: #fff6f6;
}

.metric_value {
  color: #1e293b;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.1;
}

.urgent_metric .metric_value {
  color: #dc2626;
}

.metric_label {
  margin-top: 13rpx;
  color: #52647d;
  font-size: 24rpx;
}

.metric_hint {
  margin-top: 8rpx;
  overflow-wrap: anywhere;
  color: #8b9ab0;
  font-size: 21rpx;
}

.section_head {
  margin: 42rpx 6rpx 20rpx;
}

.section_title {
  color: #1e293b;
  font-size: 32rpx;
  font-weight: 700;
}

.feature_grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: stretch;
}

.feature_slot {
  box-sizing: border-box;
  display: flex;
  width: 48.5%;
  margin-bottom: 18rpx;
}

.feature_card {
  box-sizing: border-box;
  width: 100%;
  height: 100%;
  min-height: 200rpx;
  margin: 0;
  padding: 24rpx;
  overflow: hidden;
  border: 1rpx solid #e4ebf5;
  border-radius: 20rpx;
  background: #ffffff;
  color: #17233d;
  text-align: left;
  box-shadow: 0 6rpx 18rpx rgba(30, 41, 59, 0.045);
}

.feature_card::after {
  border: 0;
}

.blue_feature {
  border-color: #cfe0ff;
  background: #f5f9ff;
}

.primary_feature {
  border-color: #cfe0ff;
  background: #eaf2ff;
  color: #1e3a8a;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.1);
}

.counselor_pending_feature {
  border-color: #cfe0ff;
  background: #eaf2ff;
  color: #1e3a8a;
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.1);
}

.counselor_focus_feature {
  border-color: #fecdd3;
  background: #fff7f8;
  color: #881337;
}

.feature_icon {
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  background: #eaf2ff;
  color: #2563eb;
  font-size: 21rpx;
  font-weight: 600;
}

.primary_feature .feature_icon {
  background: #dbeafe;
  color: #1d4ed8;
}

.counselor_focus_feature .feature_icon {
  background: #ffe4e6;
  color: #be123c;
}

.feature_badge,
.feature_status {
  flex: none;
  max-width: 100rpx;
  overflow: hidden;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: #dbeafe;
  color: #2563eb;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.primary_feature .feature_badge {
  background: #f7fbff;
  color: #1d4ed8;
}

.risk_badge {
  background: #fee2e2;
  color: #dc2626;
}

.feature_title {
  margin-top: 26rpx;
  overflow: hidden;
  color: inherit;
  font-size: 29rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature_text {
  display: -webkit-box;
  margin-top: 10rpx;
  overflow: hidden;
  color: #718197;
  font-size: 22rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.primary_feature .feature_text {
  color: #42638d;
}

.counselor_focus_feature .feature_text {
  color: #9f4b5e;
}

.state_card {
  box-sizing: border-box;
  margin-top: 64rpx;
  padding: 42rpx 30rpx;
  border: 1rpx solid #e1e9f4;
  border-radius: 20rpx;
  background: #ffffff;
  color: #64748b;
  font-size: 28rpx;
  text-align: center;
  box-shadow: 0 8rpx 22rpx rgba(30, 41, 59, 0.06);
}

.error_state {
  color: #b91c1c;
}

.retry_button {
  margin-top: 26rpx;
  border-radius: 999rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 28rpx;
}

.unbound_hint {
  margin-top: 14rpx;
  color: #718197;
  font-size: 24rpx;
  line-height: 1.55;
}

.workbench_notice {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #fff7ed;
  color: #b45309;
  font-size: 24rpx;
  line-height: 1.5;
}
